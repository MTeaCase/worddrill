<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!--
        导航条用 wrap_content：高度由内容决定，安全区再当作内边距加上去，
        这样三键导航（inset 约 48dp）和手势导航都不会把图标文字压扁。
        背景铺在导航条自己身上，内边距区域也是同一个底色，不会露出发白的空档。
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.Material3.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemActiveIndicatorStyle="@style/Widget.WordDrill.BottomNav.ActiveIndicator"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/nav_item"
        app:itemTextAppearanceActive="@style/TextAppearance.WordDrill.NavLabel"
        app:itemTextAppearanceInactive="@style/TextAppearance.WordDrill.NavLabel"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom" />
</LinearLayout>
