<?xml version="1.0" encoding="utf-8"?>
<!-- 长按图标出现的快捷入口 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_logo"
        android:shortcutId="review"
        android:shortcutLongLabel="@string/shortcut_review_long"
        android:shortcutShortLabel="@string/shortcut_review">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.worddrill.app.ui.MainActivity"
            android:targetPackage="com.worddrill.app">
            <extra
                android:name="open_review"
                android:value="true" />
        </intent>
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_search"
        android:shortcutId="dictionary"
        android:shortcutLongLabel="@string/shortcut_dict_long"
        android:shortcutShortLabel="@string/shortcut_dict">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.worddrill.app.ui.DictionaryActivity"
            android:targetPackage="com.worddrill.app" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_file"
        android:shortcutId="report"
        android:shortcutLongLabel="@string/shortcut_report_long"
        android:shortcutShortLabel="@string/shortcut_report">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.worddrill.app.ui.ReportActivity"
            android:targetPackage="com.worddrill.app" />
    </shortcut>
</shortcuts>
