<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 可暴露的目录。
  更新包下载到 external-files 下的 apk/ 目录（外部私有目录，任何版本都不需要存储权限）；
  files-path 是外部存储不可用时的兜底。
-->
<paths>
    <external-files-path
        name="apk_external"
        path="apk/" />
    <files-path
        name="apk_internal"
        path="apk/" />
</paths>
