<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WordDrill" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <!-- 不补这两个角色的话，TonalButton 会落到 Material 默认的淡紫色容器上，
             和品牌蓝完全不搭（「开始练习」就曾经因此像禁用态）。 -->
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
    </style>

    <style name="Toolbar.WordDrill" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
    </style>

    <!-- 底部导航的标签，默认偏大，压到 10sp 让整条更矮 -->
    <style name="TextAppearance.WordDrill.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- 底部导航选中态的胶囊底色（默认是 Material 的淡紫，和品牌蓝不搭） -->
    <style name="Widget.WordDrill.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_soft</item>
    </style>

    <style name="Text.SectionLabel" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 设置页的一套行式：标题 / 当前值 / 说明 / 操作，字号与颜色只有这四种 -->
    <style name="Text.SettingTitle" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.SettingValue" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.SettingDesc" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.SettingAction" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/brand</item>
    </style>

    <!-- 卡片内容统一 16dp 横向内边距：整页的文字都从同一条左基线开始 -->
    <style name="Widget.WordDrill.SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Widget.WordDrill.SettingDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="Text.CardTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.CardSubtitle" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Hero" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/hero_text</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
